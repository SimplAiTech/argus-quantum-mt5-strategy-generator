//+------------------------------------------------------------------+
//| AQ_kit_05.mq5
//| Expert Advisor generated by Argus Quantum (own MetaTrader 5 export, v1).
//| Blocks: AND, BBBarOpensAboveUp, BBBarOpensBelowDown, Boolean, BooleanVariable, CloseAllPositions, CurrentDayOfWeekIs, EnterAtMarket, KCBarOpensAboveLower, KCBarOpensBelowUpper, MarketPositionIsLong, MarketPositionIsShort, Not
//| Logic: rules are evaluated once per new bar (shift 1 = the last closed bar).
//+------------------------------------------------------------------+
#property copyright "Argus Quantum"
#property version   "1.00"
#property strict
#include <Trade\Trade.mqh>

input long   InpMagic        = 299647;     // magic number
input double InpPip          = 0.01;     // pip size in price units (0 = automatic)
input int    InpSlippage     = 30;       // max deviation, points
input double MM_Size=0.1;   // FixedSize: lots
input int    MM_Decimals=1;
input double MM_LotsIfNoMM=1.0;
input double MM_MaxLots=5.0;
input double MM_Risk=5.0;   // % of balance / account
input double MM_RiskedMoney=500.0;
input double MM_ATRMult=2.0;
input double MM_MaxSize=100.0;
input double MM_LotsStart=0.1;
input double MM_LotsMultiplier=2.0;
input double MM_LotsReset=1.0;
input bool   MM_UseAccountBalance=true;
input double InpInitialCapital=0.0;   // 0 = account balance (UseAccountBalance=false: this value)
input bool   InpFridayExit   = true;    // trading option: close everything on Friday from this time (bar open)
input int    InpFridayHour   = 20;
input int    InpFridayMin    = 40;
input bool   InpEodExit      = false;    // trading option: close everything at the end of day from this time
input int    InpEodHour      = 23;
input int    InpEodMin       = 0;
input bool   InpTimeLimit    = false;    // trading option: new orders only inside the time range
input int    InpFromHour     = 7;
input int    InpFromMin      = 0;
input int    InpToHour       = 20;
input int    InpToMin        = 0;
input bool   InpExitAtRangeEnd = false;   // close at the end of the time range
input int    InpRangeExitType = 0;   // 0 all, 1 positions only, 2 pending orders only
input bool   InpNoWeekend    = false;    // trading option: no new orders from Friday close time to Sunday open time
input int    InpWkCloseHour  = 23;
input int    InpWkCloseMin   = 0;
input int    InpWkOpenHour   = 23;
input int    InpWkOpenMin    = 0;
input int    InpMaxTradesPerDay = 0;     // trading option: 0 = no limit
input bool   InpLogTrades    = true;    // write closed trades to Common/Files/AQ_trades_<name>.csv at the end of a test

#define AQ_W 1000

CTrade   trade;
string   g_comment="AQ_kit_05";
double   g_pip=0.0;
datetime g_lastBar=0;
bool     g_allowNew=true;
int      g_tradesToday=0;
int      g_day=-1;
int      g_rangeDay=-1;
double   w_o[],w_h[],w_l[],w_c[];

int h_1=INVALID_HANDLE;
double a0_0[],a0_1[];
double a2_0[];
bool g_LongEntry=false;
bool g_ShortEntry=false;
bool g_LongExit=false;
bool g_ShortExit=false;

void AQ_atr_aq(const double &h[],const double &l[],const double &c[],const int p,double &out[])
{
   ArrayResize(out,AQ_W);
   out[0]=h[0]-l[0];
   for(int i=1;i<AQ_W;i++)
   {
      double pc=c[i-1];
      double tr=MathMax(MathAbs(l[i]-pc),MathMax(h[i]-l[i],MathAbs(h[i]-pc)));
      int k=MathMin(i+1,p);
      out[i]=((k-1)*out[i-1]+tr)/k;
   }
}

double AQ_R(const double x){ return NormalizeDouble(x+1e-10,6); }
bool AQ_Gt(const double a,const double b){ double x=AQ_R(a),y=AQ_R(b); return (x>y && MathAbs(x-y)>=1e-8); }
bool AQ_Lt(const double a,const double b){ double x=AQ_R(a),y=AQ_R(b); return (x<y && MathAbs(x-y)>=1e-8); }
bool AQ_Eq(const double a,const double b){ return (MathAbs(AQ_R(a)-AQ_R(b))<1e-8); }
double AQ_At(const double &a[],const int sh){ int i=AQ_W-sh; if(i<0 || i>=AQ_W) return 0.0; return a[i]; }
double AQ_Hv(const int h,const int buf,const int sh)
{
   double v[1];
   if(h==INVALID_HANDLE) return 0.0;
   if(CopyBuffer(h,buf,sh,1,v)!=1) return 0.0;
   return v[0];
}
double AQ_Nd(const double x,const int d){ return NormalizeDouble(x,d); }

double AQ_Open0(){ return iOpen(_Symbol,_Period,0); }
double AQ_Spread(){ return SymbolInfoDouble(_Symbol,SYMBOL_ASK)-SymbolInfoDouble(_Symbol,SYMBOL_BID); }
double AQ_Div(const double a,const double b){ if(b==0.0) return 0.0; return a/b; }

void AQ_sma(const double &x[],const int p,double &out[])
{
   ArrayResize(out,AQ_W);
   double s=0.0;
   for(int i=0;i<AQ_W;i++)
   {
      s+=x[i];
      if(i>=p) s-=x[i-p];
      out[i]=(i>=p-1)?s/p:0.0;
   }
}

void AQ_keltner(const double &h[],const double &l[],const double &c[],const int p,const double dev,const int typical,double &up[],double &lo[])
{
   double mid[],rng[],src[],bar[];
   ArrayResize(src,AQ_W); ArrayResize(bar,AQ_W);
   for(int i=0;i<AQ_W;i++){ src[i]=(typical==1)?(h[i]+l[i]+c[i])/3.0:c[i]; bar[i]=h[i]-l[i]; }
   AQ_sma(src,p,mid); AQ_sma(bar,p,rng);
   ArrayResize(up,AQ_W); ArrayResize(lo,AQ_W);
   for(int i=0;i<AQ_W;i++){ up[i]=mid[i]+dev*rng[i]; lo[i]=mid[i]-dev*rng[i]; }
}

int AQ_DOW(const int s){ MqlDateTime d; TimeToStruct(iTime(_Symbol,_Period,s),d); return d.day_of_week; }
int AQ_HOUR(const int s){ MqlDateTime d; TimeToStruct(iTime(_Symbol,_Period,s),d); return d.hour; }
int AQ_MINUTE(const int s){ MqlDateTime d; TimeToStruct(iTime(_Symbol,_Period,s),d); return d.min; }
int AQ_MONTH(const int s){ MqlDateTime d; TimeToStruct(iTime(_Symbol,_Period,s),d); return d.mon; }
int AQ_DAY(const int s){ MqlDateTime d; TimeToStruct(iTime(_Symbol,_Period,s),d); return d.day; }


// Trade requests are refused with "market closed" on the very first tick of the first bar after the daily break
// (01:00:00 server time); the bar logic is then repeated on the next ticks of the same bar (g_retry).
bool g_retry=false;
int  g_retryCnt=0;
bool g_sent[2]={false,false};
bool AQ_Chk(const bool ok)
{
   if(!ok && trade.ResultRetcode()==TRADE_RETCODE_MARKET_CLOSED) g_retry=true;
   return ok;
}
bool AQ_Sent(const int dir){ return g_sent[(dir>0)?0:1]; }
double AQ_PointValue()
{
   double ts=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE),tv=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_VALUE);
   if(ts<=0.0 || tv<=0.0) return 0.0;
   return tv/ts;
}
double AQ_RoundSize(const double x,const int dec)
{
   double y=MathFloor(x/0.01+1e-9)*0.01;
   int d=MathMin(dec,2);
   double m=MathPow(10.0,d);
   return MathFloor(y*m+0.5+1e-9)/m;
}
double AQ_Fix(const double x)
{
   double ts=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE);
   if(ts<=0.0) return NormalizeDouble(x,_Digits);
   return NormalizeDouble(MathFloor((x+1e-10)/ts+0.5)*ts,_Digits);
}
bool AQ_Has(const int dir)
{
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong tk=PositionGetTicket(i);
      if(tk==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=_Symbol || PositionGetInteger(POSITION_MAGIC)!=InpMagic) continue;
      ENUM_POSITION_TYPE t=(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      if((dir>0 && t==POSITION_TYPE_BUY) || (dir<0 && t==POSITION_TYPE_SELL)) return true;
   }
   return false;
}
bool AQ_HasPending(const int dir)
{
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      ulong tk=OrderGetTicket(i);
      if(tk==0) continue;
      if(OrderGetString(ORDER_SYMBOL)!=_Symbol || OrderGetInteger(ORDER_MAGIC)!=InpMagic) continue;
      ENUM_ORDER_TYPE t=(ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      bool buy=(t==ORDER_TYPE_BUY_STOP || t==ORDER_TYPE_BUY_LIMIT);
      bool sell=(t==ORDER_TYPE_SELL_STOP || t==ORDER_TYPE_SELL_LIMIT);
      if((dir>0 && buy) || (dir<0 && sell)) return true;
   }
   return false;
}
void AQ_DeletePending(const int dir)
{
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      ulong tk=OrderGetTicket(i);
      if(tk==0) continue;
      if(OrderGetString(ORDER_SYMBOL)!=_Symbol || OrderGetInteger(ORDER_MAGIC)!=InpMagic) continue;
      ENUM_ORDER_TYPE t=(ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      bool buy=(t==ORDER_TYPE_BUY_STOP || t==ORDER_TYPE_BUY_LIMIT);
      bool sell=(t==ORDER_TYPE_SELL_STOP || t==ORDER_TYPE_SELL_LIMIT);
      if(dir==0 || (dir>0 && buy) || (dir<0 && sell)) AQ_Chk(trade.OrderDelete(tk));
   }
}
void AQ_CloseSide(const int dir)
{
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong tk=PositionGetTicket(i);
      if(tk==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=_Symbol || PositionGetInteger(POSITION_MAGIC)!=InpMagic) continue;
      ENUM_POSITION_TYPE t=(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      if(dir==0 || (dir>0 && t==POSITION_TYPE_BUY) || (dir<0 && t==POSITION_TYPE_SELL)) AQ_Chk(trade.PositionClose(tk));
   }
}
bool AQ_PendingValid(const int dir,const bool stop,const double price,const double mkt)
{
   // buy stop / sell limit: price >= market (equal allowed); sell stop / buy limit: price <= market
   if(price<=0.0) return false;
   bool eq=(MathAbs(price-mkt)<=SymbolInfoDouble(_Symbol,SYMBOL_POINT)*0.5);
   bool ok=eq || ((stop==(dir>0))?(price>mkt):(price<mkt));
   if(!ok) return false;
   double lvl=(double)SymbolInfoInteger(_Symbol,SYMBOL_TRADE_STOPS_LEVEL)*SymbolInfoDouble(_Symbol,SYMBOL_POINT);
   if(MathAbs(price-mkt)<lvl) return false;
   return true;
}
bool AQ_LastClosed(double &size,double &pl)
{
   if(!HistorySelect(TimeCurrent()-86400*365,TimeCurrent()+86400)) return false;
   for(int i=HistoryDealsTotal()-1;i>=0;i--)
   {
      ulong d=HistoryDealGetTicket(i);
      if(d==0) continue;
      if(HistoryDealGetString(d,DEAL_SYMBOL)!=_Symbol || HistoryDealGetInteger(d,DEAL_MAGIC)!=InpMagic) continue;
      if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(d,DEAL_ENTRY)!=DEAL_ENTRY_OUT) continue;
      size=HistoryDealGetDouble(d,DEAL_VOLUME);
      pl=HistoryDealGetDouble(d,DEAL_PROFIT);
      return true;
   }
   return false;
}
bool AQ_RecentlyClosed(const bool thisBar,const bool thisMin)
{
   if(!HistorySelect(TimeCurrent()-86400*3,TimeCurrent()+86400)) return false;
   datetime bt=iTime(_Symbol,_Period,0);
   for(int i=HistoryDealsTotal()-1;i>=0;i--)
   {
      ulong d=HistoryDealGetTicket(i);
      if(d==0) continue;
      if(HistoryDealGetString(d,DEAL_SYMBOL)!=_Symbol || HistoryDealGetInteger(d,DEAL_MAGIC)!=InpMagic) continue;
      if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(d,DEAL_ENTRY)!=DEAL_ENTRY_OUT) continue;
      datetime t=(datetime)HistoryDealGetInteger(d,DEAL_TIME);
      if(thisBar && t>=bt) return true;
      if(thisMin && bt-t<=60) return true;
      return false;
   }
   return false;
}
double AQ_NormVolume(double v)
{
   double step=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP),mn=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN),mx=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX);
   if(step>0.0) v=MathFloor(v/step+1e-9)*step;
   if(v<mn) return 0.0;
   if(v>mx) v=mx;
   return NormalizeDouble(v,8);
}
// order type: 0 market, 1 stop, 2 limit
bool AQ_Send(const int dir,const int type,const double price,const double sld,const double ptd)
{
   double lots=AQ_NormVolume(AQ_MMSize(dir,price,sld));
   if(lots<=0.0) return false;
   double pt=SymbolInfoDouble(_Symbol,SYMBOL_POINT);
   double lvl=(double)SymbolInfoInteger(_Symbol,SYMBOL_TRADE_STOPS_LEVEL)*pt;
   double sl=0.0,tp=0.0;
   if(sld>0.0){ double d=MathMax(sld,lvl+pt); sl=AQ_Fix(price-dir*d); }
   if(ptd>0.0){ double d=MathMax(ptd,lvl+pt); tp=AQ_Fix(price+dir*d); }
   ENUM_ORDER_TYPE ot;
   if(type==0) ot=(dir>0)?ORDER_TYPE_BUY:ORDER_TYPE_SELL;
   else if(type==1) ot=(dir>0)?ORDER_TYPE_BUY_STOP:ORDER_TYPE_SELL_STOP;
   else ot=(dir>0)?ORDER_TYPE_BUY_LIMIT:ORDER_TYPE_SELL_LIMIT;
   double margin=0.0;
   if(OrderCalcMargin((dir>0)?ORDER_TYPE_BUY:ORDER_TYPE_SELL,_Symbol,lots,price,margin))
      if(margin>AccountInfoDouble(ACCOUNT_MARGIN_FREE)) return false;
   bool ok=false;
   if(type==0) ok=(dir>0)?trade.Buy(lots,_Symbol,0.0,sl,tp,g_comment):trade.Sell(lots,_Symbol,0.0,sl,tp,g_comment);
   else ok=trade.OrderOpen(_Symbol,ot,lots,0.0,price,sl,tp,ORDER_TIME_GTC,0,g_comment);
   AQ_Chk(ok);
   if(ok){ g_tradesToday++; g_sent[(dir>0)?0:1]=true; }
   return ok;
}
bool AQ_Pos(const int dir,ulong &tk)
{
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong t=PositionGetTicket(i);
      if(t==0) continue;
      if(PositionGetString(POSITION_SYMBOL)!=_Symbol || PositionGetInteger(POSITION_MAGIC)!=InpMagic) continue;
      ENUM_POSITION_TYPE ty=(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      if((dir>0 && ty==POSITION_TYPE_BUY) || (dir<0 && ty==POSITION_TYPE_SELL)){ tk=t; return true; }
   }
   return false;
}
void AQ_ModSL(const ulong tk,const double sl)
{
   if(!PositionSelectByTicket(tk)) return;
   double lvl=(double)SymbolInfoInteger(_Symbol,SYMBOL_TRADE_STOPS_LEVEL)*SymbolInfoDouble(_Symbol,SYMBOL_POINT);
   long ty=PositionGetInteger(POSITION_TYPE);
   double px=(ty==POSITION_TYPE_BUY)?SymbolInfoDouble(_Symbol,SYMBOL_BID):SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   if(MathAbs(px-sl)<lvl) return;
   AQ_Chk(trade.PositionModify(tk,sl,PositionGetDouble(POSITION_TP)));
}
void AQ_BarsExit(const int dir,const int eab)
{
   ulong tk;
   if(eab<=0 || !AQ_Pos(dir,tk)) return;
   if(!PositionSelectByTicket(tk)) return;
   int bars=iBarShift(_Symbol,_Period,(datetime)PositionGetInteger(POSITION_TIME),false);
   if(bars>=eab) AQ_Chk(trade.PositionClose(tk));
}
void AQ_PendingExpiry(const int dir,const int valid)
{
   if(valid<=0) return;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      ulong tk=OrderGetTicket(i);
      if(tk==0) continue;
      if(OrderGetString(ORDER_SYMBOL)!=_Symbol || OrderGetInteger(ORDER_MAGIC)!=InpMagic) continue;
      ENUM_ORDER_TYPE t=(ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      bool buy=(t==ORDER_TYPE_BUY_STOP || t==ORDER_TYPE_BUY_LIMIT);
      bool sell=(t==ORDER_TYPE_SELL_STOP || t==ORDER_TYPE_SELL_LIMIT);
      if(!((dir>0 && buy) || (dir<0 && sell))) continue;
      int bars=iBarShift(_Symbol,_Period,(datetime)OrderGetInteger(ORDER_TIME_SETUP),false);
      if(bars>=valid) AQ_Chk(trade.OrderDelete(tk));
   }
}

void AQ_DumpDeals()
{
   if(!HistorySelect(0,TimeCurrent()+86400)) return;
   int n=HistoryDealsTotal();
   ulong tk[]; long pid[]; int ent[]; datetime tm[]; double px[],vol[],pr[],cm[],sw[]; int ty[];
   ArrayResize(tk,n); ArrayResize(pid,n); ArrayResize(ent,n); ArrayResize(tm,n); ArrayResize(px,n); ArrayResize(vol,n); ArrayResize(pr,n); ArrayResize(cm,n); ArrayResize(sw,n); ArrayResize(ty,n);
   int m=0;
   for(int i=0;i<n;i++)
   {
      ulong d=HistoryDealGetTicket(i);
      if(d==0) continue;
      if(HistoryDealGetString(d,DEAL_SYMBOL)!=_Symbol || HistoryDealGetInteger(d,DEAL_MAGIC)!=InpMagic) continue;
      tk[m]=d; pid[m]=HistoryDealGetInteger(d,DEAL_POSITION_ID); ent[m]=(int)HistoryDealGetInteger(d,DEAL_ENTRY);
      tm[m]=(datetime)HistoryDealGetInteger(d,DEAL_TIME); px[m]=HistoryDealGetDouble(d,DEAL_PRICE); vol[m]=HistoryDealGetDouble(d,DEAL_VOLUME);
      pr[m]=HistoryDealGetDouble(d,DEAL_PROFIT)+HistoryDealGetDouble(d,DEAL_SWAP);
      cm[m]=HistoryDealGetDouble(d,DEAL_COMMISSION);
      sw[m]=HistoryDealGetDouble(d,DEAL_SWAP);
      ty[m]=(int)HistoryDealGetInteger(d,DEAL_TYPE);
      m++;
   }
   int h=FileOpen("AQ_trades_"+g_comment+".csv",FILE_WRITE|FILE_CSV|FILE_ANSI|FILE_COMMON,';');
   if(h==INVALID_HANDLE) return;
   FileWrite(h,"side","open_time","close_time","open_price","close_price","profit","volume","commission","swap");
   for(int i=0;i<m;i++)
   {
      if(ent[i]!=DEAL_ENTRY_OUT) continue;
      for(int j=0;j<m;j++)
      {
         if(pid[j]!=pid[i] || ent[j]!=DEAL_ENTRY_IN) continue;
         FileWrite(h,(ty[j]==DEAL_TYPE_BUY)?1:-1,TimeToString(tm[j],TIME_DATE|TIME_MINUTES),TimeToString(tm[i],TIME_DATE|TIME_MINUTES),
                   DoubleToString(px[j],_Digits),DoubleToString(px[i],_Digits),DoubleToString(pr[i],2),DoubleToString(vol[i],2),DoubleToString(cm[i]+cm[j],2),DoubleToString(sw[i],2));
         break;
      }
   }
   FileClose(h);
}

double AQ_PipAuto()
{
   int dg=(int)SymbolInfoInteger(_Symbol,SYMBOL_DIGITS);
   double pt=SymbolInfoDouble(_Symbol,SYMBOL_POINT);
   return (dg==3 || dg==5)?pt*10.0:pt;
}
double AQ_MMSize(const int dir,const double price,const double sld)
{
   double bal=AccountInfoDouble(ACCOUNT_BALANCE),eq=AccountInfoDouble(ACCOUNT_EQUITY);
   double pv=AQ_PointValue();
   double size=0.0;
   size=MM_Size;
   return size;
}

bool AQ_LoadWindow()
{
   if(CopyOpen(_Symbol,_Period,1,AQ_W,w_o)!=AQ_W) return false;
   if(CopyHigh(_Symbol,_Period,1,AQ_W,w_h)!=AQ_W) return false;
   if(CopyLow(_Symbol,_Period,1,AQ_W,w_l)!=AQ_W) return false;
   if(CopyClose(_Symbol,_Period,1,AQ_W,w_c)!=AQ_W) return false;


   return true;
}

void AQ_UpdateIndicators()
{
   AQ_keltner(w_h,w_l,w_c,20,2.25,1,a0_0,a0_1);
   AQ_atr_aq(w_h,w_l,w_c,25,a2_0);
}

void AQ_Signals()
{
   g_LongEntry=(((AQ_At(w_o,3)>AQ_R(AQ_At(a0_1,4))) && (AQ_DOW(0)==3)) && (AQ_At(w_o,2)>AQ_R(AQ_Hv(h_1,1,3))));
   g_ShortEntry=(((AQ_At(w_o,3)<AQ_R(AQ_At(a0_0,4))) && (AQ_DOW(0)==3)) && (AQ_At(w_o,2)<AQ_R(AQ_Hv(h_1,2,3))));
   g_LongExit=false;
   g_ShortExit=false;
}

void AQ_ManageL()
{
   const int dir=1;
   ulong tk;
   if(!AQ_Pos(dir,tk)) return;
   if(!PositionSelectByTicket(tk)) return;
   double open=PositionGetDouble(POSITION_PRICE_OPEN);
   double cursl=PositionGetDouble(POSITION_SL);
   double price=(dir>0)?SymbolInfoDouble(_Symbol,SYMBOL_BID):SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   double price0=open;
   double tr=(1.1*AQ_R(AQ_At(a2_0,1)));
   if(NormalizeDouble(tr,_Digits)>0.0)
   {
      double act=NormalizeDouble(0.0,_Digits);
      double pl=NormalizeDouble((price-open)*dir,_Digits);
      if(pl>=act)
      {
         double newsl=AQ_Fix(price-dir*NormalizeDouble(tr,_Digits));
         if(cursl==0.0 || (newsl-cursl)*dir>0.0) AQ_ModSL(tk,newsl);
      }
   }
}
void AQ_ManageS()
{
   const int dir=-1;
   ulong tk;
   if(!AQ_Pos(dir,tk)) return;
   if(!PositionSelectByTicket(tk)) return;
   double open=PositionGetDouble(POSITION_PRICE_OPEN);
   double cursl=PositionGetDouble(POSITION_SL);
   double price=(dir>0)?SymbolInfoDouble(_Symbol,SYMBOL_BID):SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   double price0=open;
   double tr=(1.1*AQ_R(AQ_At(a2_0,1)));
   if(NormalizeDouble(tr,_Digits)>0.0)
   {
      double act=NormalizeDouble(0.0,_Digits);
      double pl=NormalizeDouble((price-open)*dir,_Digits);
      if(pl>=act)
      {
         double newsl=AQ_Fix(price-dir*NormalizeDouble(tr,_Digits));
         if(cursl==0.0 || (newsl-cursl)*dir>0.0) AQ_ModSL(tk,newsl);
      }
   }
}

void Entry_1()
{
   const int dir=1;
   if(!g_allowNew) return;
   if(AQ_Sent(dir)) return;
   if(AQ_Has(dir)) return;
   if(AQ_Has(1) || AQ_Has(-1)) return;
   double price=(dir>0)?SymbolInfoDouble(_Symbol,SYMBOL_ASK):SymbolInfoDouble(_Symbol,SYMBOL_BID);
   double sld=(price*4.4/100.0);
   double ptd=(195.0*g_pip);
   AQ_Send(dir,0,price,sld,ptd);
}
void Entry_2()
{
   const int dir=-1;
   if(!g_allowNew) return;
   if(AQ_Sent(dir)) return;
   if(AQ_Has(dir)) return;
   if(AQ_Has(1) || AQ_Has(-1)) return;
   double price=(dir>0)?SymbolInfoDouble(_Symbol,SYMBOL_ASK):SymbolInfoDouble(_Symbol,SYMBOL_BID);
   double sld=(price*4.4/100.0);
   double ptd=(195.0*g_pip);
   AQ_Send(dir,0,price,sld,ptd);
}

void AQ_Options()
{
   g_allowNew=true;
   MqlDateTime t; TimeToStruct(iTime(_Symbol,_Period,0),t);
   int mod=t.hour*60+t.min, wd=t.day_of_week;      // 0 = Sunday ... 5 = Friday, 6 = Saturday
   if(t.day_of_year!=g_day){ g_day=t.day_of_year; g_tradesToday=0; }
   if(InpFridayExit && ((wd==5 && mod>=InpFridayHour*60+InpFridayMin) || wd==6 || wd==0))
   {
      AQ_CloseSide(0); AQ_DeletePending(0); g_allowNew=false;
   }
   if(InpEodExit && !InpTimeLimit && mod>=InpEodHour*60+InpEodMin)
   {
      AQ_CloseSide(0); AQ_DeletePending(0); g_allowNew=false;
   }
   if(InpTimeLimit)
   {
      int a=InpFromHour*60+InpFromMin, b=InpToHour*60+InpToMin;
      bool inside=(a<b)?(mod>=a && mod<b):(mod>=a || mod<b);
      if(!inside)
      {
         g_allowNew=false;
         if(InpExitAtRangeEnd && g_rangeDay!=t.day_of_year)
         {
            g_rangeDay=t.day_of_year;
            if(InpRangeExitType!=2) AQ_CloseSide(0);
            if(InpRangeExitType!=1) AQ_DeletePending(0);
         }
      }
   }
   if(InpNoWeekend && ((wd==5 && mod>=InpWkCloseHour*60+InpWkCloseMin) || wd==6 || (wd==0 && mod<InpWkOpenHour*60+InpWkOpenMin))) g_allowNew=false;
   if(InpMaxTradesPerDay>0 && g_tradesToday>=InpMaxTradesPerDay) g_allowNew=false;
}

void AQ_Rules()
{
   if(g_LongEntry) Entry_1();
   if((g_ShortEntry && (!g_LongEntry))) Entry_2();
   if(((g_LongExit && (!g_LongEntry)) && AQ_Has(1))) AQ_CloseSide(1);
   if(((g_ShortExit && (!g_ShortEntry)) && AQ_Has(-1))) AQ_CloseSide(-1);
}

int OnInit()
{
   g_pip=(InpPip>0.0)?InpPip:AQ_PipAuto();
   trade.SetExpertMagicNumber((ulong)InpMagic);
   trade.SetDeviationInPoints((ulong)InpSlippage);
   trade.SetTypeFillingBySymbol(_Symbol);
   h_1=iBands(_Symbol,_Period,50,0,2.1,PRICE_CLOSE);
   if(h_1==INVALID_HANDLE) return INIT_FAILED;
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   if(InpLogTrades) AQ_DumpDeals();
   if(h_1!=INVALID_HANDLE) IndicatorRelease(h_1);
}

void AQ_Bar()
{
   AQ_UpdateIndicators();
   AQ_ManageL();
   AQ_ManageS();

   AQ_Options();

   AQ_Signals();
   AQ_Rules();
}

void OnTick()
{
   datetime bt=iTime(_Symbol,_Period,0);
   if(bt==g_lastBar)
   {
      // the previous attempt of this bar was refused with "market closed": repeat it on the next ticks
      if(!g_retry || g_retryCnt>=200) return;
      g_retryCnt++;
   }
   else
   {
      g_retryCnt=0; g_sent[0]=false; g_sent[1]=false;
   }
   if(!AQ_LoadWindow()) return;
   g_lastBar=bt;
   g_retry=false;
   AQ_Bar();
}
